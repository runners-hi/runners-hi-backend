(pages) {
	handle /privacy {
		root * /srv/runnershi/pages
		rewrite * /privacy.html
		file_server
	}
	handle /delete-account {
		root * /srv/runnershi/pages
		rewrite * /delete-account.html
		file_server
	}
	handle /terms {
		root * /srv/runnershi/pages
		rewrite * /terms.html
		file_server
	}
	# 상태 확인 경로는 외부에 열지 않는다
	handle /actuator/* {
		respond 404
	}
}

runnershi-api.oguriworks.com {
	encode gzip
	import pages
	handle {
		reverse_proxy localhost:8080
	}
}

# 개발 서버: 별도 스키마(dev)와 시드 데이터를 쓴다
runnershi-dev-api.oguriworks.com {
	encode gzip
	import pages
	handle {
		reverse_proxy localhost:8081
	}
}

# mockwire 호스팅 프록시 (목 응답·에러·끊김 주입). 배포 때 지워지지 않게 여기 둔다
runnershi-mock.oguriworks.com {
	encode gzip
	handle {
		reverse_proxy localhost:8899
	}
}
