{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runners-hi-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "runnershi-api.oguriworks.com", "custom_domain": true }
  ],
  // Supabase 무료 프로젝트가 7일 미사용으로 멈추지 않게 하루 한 번 DB까지 확인한다
  "triggers": { "crons": ["0 18 * * *"] },
  "containers": [
    {
      "class_name": "BackendContainer",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "BackendContainer" }]
  },
  "exports": {
    "BackendContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "SPRING_PROFILES_ACTIVE": "prod",
    "STORAGE_BUCKET_NAME": "runners-hi-profile",
    "STORAGE_PUBLIC_BASE_URL": "https://runnershi-img.oguriworks.com"
  }
}
