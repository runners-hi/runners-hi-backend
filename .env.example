# ===========================================
# Runners-Hi Backend Environment Variables
# ===========================================
# 이 파일을 복사하여 .env 또는 .env.local로 저장하세요.
# cp .env.example .env.local
#
# 환경별 필수 변수:
# - local: 기본값 사용 (환경 변수 불필요)
# - dev/prod: 모든 변수 필수
# ===========================================

# Database
DB_URL=jdbc:postgresql://localhost:5432/runners_hi
DB_USERNAME=postgres
DB_PASSWORD=password

# JWT (prod 환경 필수, 256bit 이상)
JWT_SECRET=your-secret-key-here-minimum-256-bits-required

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=com.runnershi.app

# 프로필 사진 저장소 (Cloudflare R2, S3 호환)
STORAGE_BUCKET_NAME=runners-hi-profile
STORAGE_PUBLIC_BASE_URL=https://runnershi-img.oguriworks.com
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# 푸시 (FCM). 파일 경로 또는 base64 중 하나
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_BASE64=
